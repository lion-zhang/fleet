  "name": "io.github.lion-zhang/fleet",
  "title": "fleet",
  "description": "Every machine you have, for your coding agent: live GPU, VRAM, RAM and disk, and SSH.",
  "version": "0.5.0",
  "repository": {
    "url": "https://github.com/lion-zhang/fleet",
    "source": "github"
  },
  "websiteUrl": "https://github.com/lion-zhang/fleet",
  "packages": [
    {
